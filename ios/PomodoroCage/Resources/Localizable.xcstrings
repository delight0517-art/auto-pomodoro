          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のブロックがまもなく始まります。保存時間が必要な場合は、5分延長するか今日のブロックをスキップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 即将被屏蔽。如需更多保存时间，可延长 5 分钟或跳过今天的屏蔽。"
          }
        }
      }
    },
