    "settings.durationRules.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기의 시간 규칙을 이곳에서 추가·수정·삭제할 수 있고, 블루클라우드 계정의 기기와 동기화돼요. 시간대가 겹치면 목록에서 먼저 오는 규칙이 적용돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add, edit, or delete time rules from any device here. Changes sync with devices on your BlueCloud account. When time ranges overlap, the first matching rule in the list applies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのデバイスの時間ルールもここで追加・編集・削除でき、BlueCloudアカウントのデバイスと同期されます。時間帯が重なる場合は、一覧で先にあるルールが適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在此添加、编辑或删除任何设备的时间规则，并与 BlueCloud 账户中的设备同步。时间段重叠时，列表中最先匹配的规则生效。"
          }
        }
      }
    },
    "settings.durationRules.invalidRange": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작과 종료 시각을 다르게 설정해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose different start and end times."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻と終了時刻を別々に設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将开始和结束时间设为不同时间。"
          }
        }
