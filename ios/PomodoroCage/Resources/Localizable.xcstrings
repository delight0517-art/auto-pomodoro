    "appLimit.warning.permission.message": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 앱 차단은 3분 전 알림과 소리가 준비된 경우에만 저장할 수 있어요. 설정에서 알림, 사운드, 시간 민감 알림을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled app blocking can be saved only when its 3-minute warning and sound are enabled. Allow notifications, sounds, and Time Sensitive notifications in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3分前の通知とサウンドが有効な場合のみ、アプリの予約ブロックを保存できます。設定で通知、サウンド、時間指定要約を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在启用提前 3 分钟通知和声音时，才能保存定时应用屏蔽。请在设置中允许通知、声音和时间敏感通知。"
          }
        }
      }
    },
