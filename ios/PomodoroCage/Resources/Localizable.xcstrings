{
  "sourceLanguage": "ko",
  "strings": {
    "appLimit.activeSchedule.notice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단 시간은 지금 진행 중이라 수정하거나 삭제할 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This blocking schedule is active and cannot be edited or deleted right now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブロック時間は現在適用中のため、編集・削除できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏蔽时段正在生效，目前无法修改或删除。"
          }
        }
      }
    },
    "appLimit.allowedMaxMinutes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 최대 %d분 허용"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ max %d min allowed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最大%d分まで許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最多允许 %d 分钟"
          }
        }
      }
    },
    "appLimit.allowedMinutes.stepper": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 허용 시간: %d분"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ allowed time: %d min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 利用可能時間: %d分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 允许时长：%d 分钟"
          }
        }
      }
    },
    "appLimit.delete.button": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간 제한 규칙 삭제"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this app limit rule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この利用制限ルールを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此应用限制规则"
          }
        }
      }
    },
    "appLimit.description.daily": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 자정(00:00)에 사용 시간이 리셋돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage resets daily at midnight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日午前0時に利用時間がリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天午夜 00:00 重置使用时长。"
          }
        }
      }
    },
    "appLimit.description.hourly": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 시간(정각)마다 사용 시간이 리셋돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage resets at the start of every hour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎時（00分）に利用時間がリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时整点重置使用时长。"
          }
        }
      }
    },
    "appLimit.description.scheduled": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 지정한 시간 동안 선택한 앱을 차단해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps are blocked every day during the scheduled hours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、指定した時間帯に選択したアプリをブロックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在设定时段屏蔽所选应用。"
          }
        }
      }
    },
    "appLimit.error.register": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약을 등록하지 못했어요: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not register schedule: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを登録できませんでした: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注册计划：%@"
          }
        }
      }
    },
    "appLimit.fallback.name": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "appLimit.hourlyCap.add": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 시간당 30분 넘으면 차단"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block after 30 minutes each hour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間に30分を超えたらブロック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时超过30分钟后屏蔽"
          }
        }
      }
    },
    "appLimit.hourlyCap.name": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사용 제한"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usage cap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 利用制限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@使用限制"
          }
        }
      }
    },
    "appLimit.interval.daily": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루당"
          }
        },
