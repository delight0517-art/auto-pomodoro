    "feedback.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 불안정해 피드백을 보내지 못했어. 잠시 후 다시 확인해줘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send feedback due to a connection issue. Try again shortly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の問題でフィードバックを送信できませんでした。しばらくしてからお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接异常，暂时无法发送反馈。请稍后重试。"
          }
        }
      }
    },
    "feedback.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 적거나 이미지를 첨부해줘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter details or attach an image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
