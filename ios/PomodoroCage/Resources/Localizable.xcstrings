    "appLimit.interval.scheduled": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 차단"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled block"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間指定ブロック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时屏蔽"
          }
        }
      }
    },
    "appLimit.limit.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 앱의 사용량이 %@ %d분을 넘으면 다음 리셋 시간까지 자동으로 앱이 차단됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When app usage exceeds %@ %d min, the app is blocked until the next reset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの使用時間が%@ %d分を超えると、次のリセットまでブロックされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选应用使用时间超过 %@ %d 分后，将自动屏蔽至下次重置。"
          }
        }
      }
    },
    "appLimit.name.daily": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
