    "block.info.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using Apple's official Screen Time API (ManagedSettings), it blocks safely at the system level without draining battery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple公式Screen Time API（ManagedSettings）を使用しているため、バッテリー消費なしでシステムレベルで安全にブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 공식 Screen Time API(ManagedSettings)를 사용하므로 배터리 소모 없이 시스템 차원에서 안전하게 차단됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 官方 Screen Time API（ManagedSettings），可在系统层面安全阻止，且不耗电。"
          }
        }
      }
    },
