    "settings.strictLock.activeBreakNotice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 쉬는 시간이 끝날 때까지 이 설정을 끌 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting cannot be turned off until the current break ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の休憩が終わるまで、この設定はオフにできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前休息结束前无法关闭此设置。"
          }
        }
      }
    },
    "settings.strictLock.disabledDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐: 쉬는 시간을 직접 건너뛸 수 있어요. 변경 내용은 같은 블루클라우드 계정에 동기화돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: you can skip breaks. Changes sync to the same BlueCloud account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ: 休憩をスキップできます。変更は同じ BlueCloud アカウントに同期されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：可以跳过休息。更改会同步到同一 BlueCloud 账户。"
          }
        }
      }
    },
    "settings.strictLock.enabledDescription": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜짐: 쉬는 시간 건너뛰기와 일시정지를 막고 Mac·Windows와 같은 정책을 사용해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: skipping and pausing breaks are blocked, matching the Mac and Windows policy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン: 休憩のスキップと一時停止を禁止し、Mac・Windows と同じポリシーを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启：禁止跳过或暂停休息，并与 Mac 和 Windows 使用相同策略。"
          }
        }
      }
    },
    "settings.strictLock.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break lock policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩中のロック設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 시간 잠금 정책"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息期间的锁定策略"
          }
        }
      }
    },
    "settings.strictLock.toggle": {
