    "settings.autoStart.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Auto-start detection is enabled after granting Screen Time permission. Please allow permission in the 'App Blocking' tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 自動開始検知はScreen Timeの権限承認後に有効になります。『アプリブロック』タブで権限を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 자동 시작 감지는 Screen Time 권한 승인 후 활성화돼요. '앱 차단' 탭에서 권한을 허용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 自动启动检测在获得屏幕时间权限后启用。请在“应用阻止”标签中授权。"
          }
        }
      }
    },
    "settings.bgRefresh.denied.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App usage detection depends on Screen Time permission and your selected apps. Tap the detection notification to start Pomodoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの使用検知にはスクリーンタイムの許可と選択したアプリが必要です。検知通知をタップしてポモドーロを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 감지는 Screen Time 권한과 선택한 앱에 따라 동작해요. 감지 알림을 누르면 포모도로를 시작할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用使用检测需要屏幕使用时间权限和所选应用。轻点检测通知即可开始番茄钟。"
          }
        }
      }
    },
    "settings.bluecloud.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in with the same BlueCloud account (ID + password) used in the Mac/Windows app to sync settings and stats. An account will be created automatically if you don't have one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac/Windowsアプリと同じBlueCloudアカウント（ID+パスワード）でログインすると設定・統計が同期されます。アカウントがない場合は自動で作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac/Windows 앱에서 쓰는 것과 같은 블루클라우드 계정(아이디+비밀번호)으로 로그인하면 설정·통계가 맞춰져요. 계정이 없으면 자동으로 만들어져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与 Mac/Windows 应用相同的蓝云账户（用户名+密码）登录后，设置和统计将同步。若无账户，将自动创建。"
          }
        }
      }
    },
