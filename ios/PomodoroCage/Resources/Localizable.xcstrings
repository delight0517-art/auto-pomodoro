    "appLimit.pause.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약 차단을 얼마나 끌까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long should the scheduled block stay off?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約ブロックをどのくらい停止しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时屏蔽要暂停多久？"
          }
        }
      }
    },
    "appLimit.schedule.end": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 종료"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block ends"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽结束"
          }
        }
      }
    },
    "appLimit.schedule.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 시각부터 종료 시각까지 차단해요. 종료 시각이 더 이르면 다음 날 해제돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps stay blocked from the start time until the end time. An earlier end time means the block ends the next day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時刻から終了時刻までブロックします。終了時刻が開始より早い場合、翌日に解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从开始时间到结束时间屏蔽应用。如果结束时间更早，则在次日解除。"
          }
        }
      }
    },
    "appLimit.schedule.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 시간은 15분 이상으로 설정해 주세요. 시작과 종료는 달라야 해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a block period of at least 15 minutes. Start and end must differ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック時間は15分以上にしてください。開始時刻と終了時刻は異なる必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽时长至少为 15 分钟，开始和结束时间不能相同。"
          }
        }
      }
    },
    "appLimit.schedule.section": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 주기 및 허용 시간"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
