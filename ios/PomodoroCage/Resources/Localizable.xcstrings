    "stats.mac.sleeping.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 절전 진입을 요청했어요. 실제 절전과 오프라인 상태는 마지막 신호만으로 구분할 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac reported a sleep request. Its last signal cannot confirm whether it actually slept or went offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac からスリープ要求が届きました。最後の信号だけでは実際にスリープしたか、オフラインかを判別できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 报告了睡眠请求。仅凭最后一次信号无法确认它是否实际进入睡眠或已离线。"
          }
        }
      }
    },
