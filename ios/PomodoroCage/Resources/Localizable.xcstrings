        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间设置"
          }
        }
      }
    },
    "settings.timerCloud.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is separate from BlueCloud — it only exchanges whether the timer is running and how much time is left in real time. An account will be created automatically if you don't have one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはBlueCloudとは別物です — タイマーが現在実行中か、残り時間がどれだけあるかをリアルタイムでやり取りします。アカウントがない場合は自動的に作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이건 블루클라우드와 별개예요 — 타이머가 지금 돌고 있는지/얼마나 남았는지만 실시간으로 주고받아요. 계정이 없으면 자동으로 만들어져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这与 BlueCloud 无关——仅实时同步计时器当前是否运行及剩余时间。如果没有账户，将自动创建。"
          }
        }
      }
    },
