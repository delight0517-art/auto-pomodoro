    "settings.wakeLock.chooseNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose apps to block now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐブロックするアプリを選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단할 앱 선택"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即选择要拦截的应用"
          }
        }
      }
    },
    "settings.wakeLock.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a wake signal is confirmed, selected items are blocked with Screen Time. The YouTube app and youtube.com are separate targets. Screen Time permission and selection on this iPhone are required; syncing wake time alone cannot guarantee blocking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床信号が確認されると、選択した項目をスクリーンタイムでブロックします。YouTubeアプリとyoutube.comは別の対象です。スクリーンタイムの権限とこのiPhoneでの選択が必要で、起床時刻の同期だけではブロックは保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 신호가 확인되면 선택 항목을 Screen Time으로 잠가요. YouTube 앱과 youtube.com은 별도 대상이에요. Screen Time 권한과 이 iPhone에서의 앱 선택이 필요하며, 기상 시각 동기화만으로 차단이 보장되지는 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认起床信号后，会通过屏幕使用时间拦截所选项目。YouTube 应用和 youtube.com 是不同目标。需要屏幕使用时间权限并在此 iPhone 上选择；仅同步起床时间无法保证拦截。"
          }
        }
      }
    },
    "settings.wakeLock.localBehavior": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 선택한 앱 사용을 Screen Time으로 감지해 오프라인에서도 기상 잠금을 시작해요. 중요 일정 시작 30분 전부터는 잠금이 적용되지 않아요. 앱 선택은 이 iPhone에 저장되며, 선택 대상이 없으면 잠글 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone detects selected app use with Screen Time and can start wake protection offline. Protection is paused starting 30 minutes before important events. App selection is stored on this iPhone; with no selected targets, it cannot block anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneはスクリーンタイムで選択したアプリの使用を検知し、オフラインでも起床後のロックを開始できます。重要な予定の開始30分前からロックは適用されません。アプリの選択はこのiPhoneに保存され、対象が選択されていない場合はブロックできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 会通过屏幕使用时间检测所选应用的使用情况，并可在离线时启动起床后锁定。重要日程开始前 30 分钟起不应用锁定。应用选择保存在这部 iPhone 上；未选择目标时无法拦截。"
          }
        }
      }
    },
    "settings.wakeLock.duration": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
