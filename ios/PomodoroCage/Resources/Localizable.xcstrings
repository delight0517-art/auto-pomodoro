    "settings.shared.description": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 바꾼 값은 같은 블루클라우드 계정의 Mac·Windows 설정에 반영됩니다. 기기별로 지원하지 않는 동작은 해당 컴퓨터에서만 실행됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes here sync to Mac and Windows settings on the same BlueCloud account. Actions unsupported by a device run only on that computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで変更した値は、同じBlueCloudアカウントのMac・Windows設定に同期されます。端末が対応していない動作は、そのコンピュータ上でのみ実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处更改的值会同步到同一 BlueCloud 账号的 Mac 和 Windows 设置。设备不支持的操作只会在对应电脑上执行。"
          }
        }
      }
    },
