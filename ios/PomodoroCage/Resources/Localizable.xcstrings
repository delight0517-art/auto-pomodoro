    "settings.timeSettings.nextCycle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 바꾸면 진행 중인 회차는 유지되고 다음 회차부터 적용돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time changes keep the current session and take effect in the next cycle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を変更しても現在のセッションは維持され、次のサイクルから適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改时长不会影响当前阶段，将从下一轮开始生效。"
          }
        }
      }
    },
    "settings.timeSettings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
