    "appLimit.sharedCategory.customID.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 ID는 영문 소문자·숫자·점·밑줄·하이픈으로 1~64자, 기기당 한 규칙에만 사용하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–64 lowercase letters, numbers, periods, underscores, or hyphens. Use each group ID for only one rule per device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループIDは小文字の英字・数字・ピリオド・アンダースコア・ハイフンを1～64文字で入力し、1台につき1つのルールだけに使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组 ID 长度为 1–64 个字符，只能包含小写英文字母、数字、句点、下划线或连字符；每台设备的一个规则只能使用一个组 ID。"
          }
        }
      }
    },
    "appLimit.sharedCategory.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 선택한 뒤 아래에서 하루 한도와 앱을 지정하세요. 같은 Pomodoro 계정의 기기끼리 설정과 확인된 사용 기록을 동기화합니다. Screen Time 앱 선택은 각 기기에만 저장됩니다. 현재 동시 사용 구간은 중복 합산될 수 있으며, Detox·Focus Fence와의 사용량 통합은 아직 연결되지 않았습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category, then set its daily limit and apps below. Pomodoro devices on the same account sync the setting and confirmed usage. Screen Time app selections stay on each device. Overlapping use may currently be counted twice; Detox and Focus Fence usage are not connected yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを選び、下で1日の上限とアプリを設定します。同じPomodoroアカウントのデバイス間で設定と確認済みの使用記録を同期します。Screen Timeのアプリ選択は各デバイスに保存されます。現在、同時利用は重複計上される可能性があり、Detox・Focus Fenceとの使用量統合も未接続です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择类别后，在下方设置每日上限和应用。同一 Pomodoro 账户的设备会同步设置和已确认的使用记录。Screen Time 应用选择保存在各设备本地。目前同时使用可能被重复计入；Detox 和 Focus Fence 的使用量尚未接入。"
          }
        }
      }
    },
