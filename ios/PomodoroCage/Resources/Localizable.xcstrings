    "feedback.form.basicDiagnostics": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머 상태, 로그인 여부, 적용 중인 스케줄 같은 최소 진단 정보만 같이 전송돼요. 비밀번호나 선택한 앱 목록은 보내지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only basic diagnostics such as timer state, sign-in status, and active schedules are included. Passwords and selected app lists are not sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー状態、ログイン状態、適用中のスケジュールなどの基本診断情報のみ送信されます。パスワードや選択したアプリ一覧は送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送计时器状态、登录状态和当前计划等基本诊断信息，不会发送密码或所选应用列表。"
          }
        }
      }
    },
