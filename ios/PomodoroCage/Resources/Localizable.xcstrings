    "settings.troubleshooting.intro": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time 권한, 감지할 앱 선택, 알림 허용 상태를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Screen Time permission, selected apps, and notification access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time の許可、検知するアプリ、通知設定を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查屏幕使用时间权限、所选应用和通知权限。"
          }
        }
      }
    },
    "settings.troubleshooting.step1.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm permission is approved in the App Blocking tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリブロック」タブで許可済みか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 차단 탭에서 권한 상태가 승인됨인지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“应用屏蔽”标签中确认权限已获批准。"
          }
        }
      }
    },
    "settings.troubleshooting.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Screen Time permission"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time の許可を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time 권한 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查屏幕使用时间权限"
          }
        }
      }
    },
    "settings.troubleshooting.step2.desc": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지할 앱 선택에서 사용량을 확인할 앱이 포함되어 있는지 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the apps you want to monitor are included in your selection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検知するアプリの選択に、使用状況を確認したいアプリが含まれているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认要检测使用情况的应用已添加到所选列表。"
          }
        }
      }
    },
    "settings.troubleshooting.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지할 앱 선택"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select apps to monitor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検知するアプリを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要检测的应用"
          }
        }
      }
    },
    "settings.troubleshooting.step3.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After usage of a selected app accumulates, you’ll receive an alert. Tap it to start the iOS Pomodoro timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアプリの使用が一定時間累積すると通知が届きます。iOS版ポモドーロを開始するには通知をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱의 사용이 누적되면 알림이 와요. 알림을 눌러야 iOS 포모도로 타이머가 시작돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选应用的使用时间累计后会收到通知。点击通知即可启动 iOS 番茄钟计时器。"
          }
        }
      }
    },
    "settings.troubleshooting.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 눌러 세션 시작"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the alert to start a session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をタップしてセッションを開始"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击通知以开始专注"
          }
        }
      }
    },
    "settings.troubleshooting.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 감지 알림이 오지 않을 때"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you do not receive app-usage alerts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用検知の通知が届かない場合"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到应用使用检测通知时"
          }
        }
      }
