    "notif.appLimit.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 %@ 허용 시간(%d분)을 모두 사용했어요. 다음 초기화까지 차단돼요."
          }
        },
        "en": {
