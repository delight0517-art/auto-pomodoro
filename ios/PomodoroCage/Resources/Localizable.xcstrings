    "settings.sleepState.risesyncOnly": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 판정과 수면 데이터는 RiseSync에서 관리해요. 포모도로는 RiseSync 기상 신호를 받아 이 iPhone에서 선택한 앱을 잠급니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RiseSync owns wake decisions and sleep data. Pomodoro receives its wake signal and locks apps selected on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床判定と睡眠データはRiseSyncで管理します。ポモドーロはRiseSyncの起床信号を受け、このiPhoneで選んだアプリをロックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床判定和睡眠数据由 RiseSync 管理。番茄钟接收其起床信号，并锁定此 iPhone 上所选的应用。"
          }
        }
      }
    },
