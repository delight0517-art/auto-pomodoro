        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではヘルスケアの睡眠データを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Health 수면 데이터를 사용할 수 없어요"
          }
        },
        "zh-Hans": {
