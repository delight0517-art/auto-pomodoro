    "widgetGuide.addWidgetInstructions": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 빈 곳을 길게 누르고 +를 탭한 뒤, Auto Pomodoro를 검색해 위젯 추가를 누르세요. 위젯은 집중·휴식 단계와 휴식 종료 시각을 계속 보여줘요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty Home Screen area, tap +, search for Auto Pomodoro, then tap Add Widget. The widget shows focus/rest phases and the rest end time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の空き領域を長押しして「+」をタップし、Auto Pomodoroを検索して「ウィジェットを追加」を選びます。集中・休憩の段階と休憩終了時刻が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕空白处，点按“+”，搜索 Auto Pomodoro，然后点按“添加小组件”。小组件会显示专注/休息阶段和休息结束时间。"
          }
        }
      }
    },
    "widgetGuide.cardSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중·휴식 단계와 남은 시간을 확인해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the focus or rest phase and time remaining."
