    "appLimit.pause.24hours": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 하루 끄기 (24시간)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off for 24 hours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間オフ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭24小时"
          }
        }
      }
    },
    "appLimit.pause.3days": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 후 다시 켜기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn back on in 3 days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日後に再びオン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3天后重新开启"
          }
        }
      }
    },
    "appLimit.pause.8hours": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8시간 끄기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
