      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱이 열려 있을 때 상태를 갱신해요. 백그라운드 푸시 알림은 아직 지원하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS refreshes this status while the app is open. Background push notifications are not supported yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS はアプリを開いている間に状態を更新します。バックグラウンドプッシュには未対応です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会在应用打开时刷新状态，暂不支持后台推送通知。"
