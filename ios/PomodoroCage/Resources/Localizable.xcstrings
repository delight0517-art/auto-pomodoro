    "settings.syncNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Mac and Windows timers now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
