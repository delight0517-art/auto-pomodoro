    "settings.dailyLimit.help": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱의 하루 누적 사용 시간이 한도에 도달하면 자정까지 iOS가 차단해요. 앱을 열어두지 않아도 작동합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When selected apps reach their combined daily limit, iOS blocks them until midnight. The app does not need to stay open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアプリの1日の合計使用時間が上限に達すると、iOSが深夜までブロックします。アプリを開いたままにする必要はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选应用的每日累计使用时间达到上限后，iOS 会阻止它们直到午夜。无需保持本应用打开。"
          }
        }
      }
    },
