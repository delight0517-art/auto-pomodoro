          "stringUnit": {
            "state": "translated",
            "value": "%@の%@利用上限（%d分）に達しました。次のリセットまでブロックされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的%@使用时长已达到 %d 分钟，将屏蔽至下次重置。"
          }
        }
      }
    },
