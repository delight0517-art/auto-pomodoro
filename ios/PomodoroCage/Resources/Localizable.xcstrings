    },
    "settings.sleepState.healthSync.noRecords": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent Health sleep records. Check sleep records and sharing in the Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のヘルスケア睡眠記録がありません。ヘルスケアアプリの睡眠記録と共有設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 Health 수면 기록이 없어요 · Health 앱의 수면 기록과 공유 설정을 확인해 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有最近的健康睡眠记录。请检查健康 App 中的睡眠记录和共享设置。"
          }
        }
      }
    },
    "settings.sleepState.healthSync.requestFailed": {
      "extractionState": "manual",
