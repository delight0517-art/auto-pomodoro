    "settings.autoStart.selectApps.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When selected apps reach one accumulated minute of use, iOS records an activity timestamp and sends it to desktop Auto Pomodoro on the next BlueCloud sync. App names are not sent. This selection also powers app-usage alerts and focus auto-start; iOS does not report app switches in real time. Leave Bible and rest apps unselected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアプリの使用が累計1分に達すると、iOSが活動時刻を記録し、次回のBlueCloud同期でデスクトップ版Auto Pomodoroに送ります。アプリ名は送信しません。この選択は使用通知と集中の自動開始にも使われます。iOSはアプリ切り替えをリアルタイムで検知しません。聖書や休憩用アプリは選択しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 앱의 사용 시간이 1분 누적되면 iOS가 활동 시각을 기록하고 다음 BlueCloud 동기화 때 데스크톱 Auto Pomodoro에 전달해요. 앱 이름은 전송하지 않아요. 이 설정은 앱 사용 알림과 집중 자동 시작에도 함께 쓰이며, 앱 전환을 실시간으로 감지하지는 않아요. 성경·휴식 앱은 선택하지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选应用的累计使用达到1分钟后，iOS会记录活动时间，并在下次BlueCloud同步时发送给桌面版Auto Pomodoro。不会发送应用名称。此选择也用于应用使用提醒和专注自动开始；iOS无法实时检测应用切换。请勿选择圣经或休息应用。"
          }
        }
      }
    },
    "settings.autoStart.shortcutsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For instant start when an app opens, create a Shortcuts personal automation: App → Is Opened → Start Auto Pomodoro Focus. Create one automation per app. It switches to Auto Pomodoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いたときにすぐ開始するには、ショートカットで個人用オートメーションを作成し、「App → 開いたとき → Start Auto Pomodoro Focus」を設定してください。アプリごとに作成が必要です。実行するとAuto Pomodoroに切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열 때 바로 시작하려면 단축어 앱에서 개인용 자동화 → 앱 → 열릴 때를 만들고 ‘Start Auto Pomodoro Focus’를 추가하세요. 대상 앱별로 자동화를 만들어야 하며, 실행하면 Auto Pomodoro로 전환돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在打开应用时立即开始，请在“快捷指令”中创建个人自动化：App → 打开时 → Start Auto Pomodoro Focus。每个应用都需单独创建。运行时会切换到 Auto Pomodoro。"
          }
        }
      }
    },
    "settings.autoStart.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱 사용을 작업 활동으로 감지"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect selected app use as work activity"
