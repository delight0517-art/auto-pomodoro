    "feedback.form.event": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "🎁 BlueCloud Premium 이용권을 드리는 피드백 감사 이벤트를 준비 중이에요. 일정과 참여·선정 기준은 앱 공지에서 안내할게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🎁 We’re preparing a feedback thank-you event with BlueCloud Premium passes. Dates and entry/selection details will be announced in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "🎁 BlueCloud Premium 利用券を贈るフィードバック感謝企画を準備中です。開催時期と参加・選考条件はアプリ内でお知らせします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🎁 我们正在筹备赠送 BlueCloud Premium 会员权益的反馈感谢活动。活动时间、参与和评选规则将在应用内公布。"
          }
        }
      }
    },
    "feedback.form.extendedDiagnostics": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 기록과 차단 규칙 요약도 첨부"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach session history and blocking rule summary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション履歴とブロックルールの概要を添付"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加会话记录和屏蔽规则摘要"
          }
        }
      }
    },
    "feedback.form.extendedDiagnostics.detail": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간의 최근 세션 최대 20개(태그 포함), 현재 차단 규칙 이름·시간, 앱 선택 개수, Screen Time 감시 등록 상태와 최근 오류를 보내요. 앱을 식별하는 원본 토큰은 보내지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, up to 20 sessions from the selected period (including tags), current blocking rule names and times, selection counts, Screen Time monitor status and its latest error, and preferred device languages are sent. Raw tokens that identify apps are never attached."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択期間内の最新20件までのセッション（タグを含む）、現在のブロックルール名と時間、選択数、Screen Time の監視状態と最新エラー、端末の優先言語を送信します。アプリを特定する生トークンは送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后会发送所选时间范围内最多 20 条会话（含标签）、当前屏蔽规则名称与时间、所选数量、Screen Time 监控状态和最近错误，以及设备首选语言。不会发送可识别应用的原始令牌。"
          }
        }
      }
    },
    "feedback.form.imageError": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 준비하지 못했어. 다른 사진을 골라줘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare the image. Choose another photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を準備できませんでした。別の写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备图片，请选择其他照片。"
          }
        }
      }
    },
    "feedback.form.imagePrivacy": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 이미지는 전송 전에 JPEG로 축소하며, 피드백과 함께 보관돼요. 사진을 고르지 않으면 전송하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected images are resized to JPEG before sending and stored with the feedback. No image is sent unless you choose one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した画像は送信前に JPEG に縮小され、フィードバックと一緒に保存されます。選択しない限り送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片会在发送前缩小为 JPEG，并与反馈一起保存。未选择图片时不会发送。"
          }
        }
      }
    },
    "feedback.form.intro": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 겪은 문제나 아이디어를 보내면 iOS 포모도로도 Brainwire 공통 피드백 인박스에 바로 들어가요. 처리 흐름과 보상 기준은 다른 iOS 앱들과 공유돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a problem or idea to the shared Brainwire feedback inbox. Processing and rewards are shared with other iOS apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題やアイデアを送ると、iOS版ポモドーロも Brainwire 共通フィードバック受信箱に届きます。対応フローと報酬基準は他の iOS アプリと共通です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交问题或想法后，iOS 番茄钟反馈会进入 Brainwire 共享收件箱。处理流程和奖励标准与其他 iOS 应用共用。"
          }
        }
      }
    },
