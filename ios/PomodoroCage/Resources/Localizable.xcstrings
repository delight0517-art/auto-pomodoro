    "block.sharedUsage.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage is combined across devices in the same group (for example, sns). iOS reports minimum confirmed usage based on OS thresholds, so it may be lower than real-time total usage. Create separate rules for different app limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じグループ（例: sns）の端末間で使用量を合算します。iOSの値はOSのしきい値に基づく確認済み使用量の最小値で、リアルタイムの合計より少ない場合があります。アプリごとに異なる制限を設定するには、個別のルールを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 합산 그룹(예: sns)을 연결한 기기들의 사용량을 합칩니다. iOS 값은 OS가 알려준 임계값 기준의 최소 확인 사용량이며 실시간 총 사용량보다 작을 수 있습니다. 앱별로 다른 한도를 쓰려면 앱마다 규칙을 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一组（例如 sns）中的设备会合并用量。iOS 数值是基于系统阈值确认的最低用量，可能低于实时总用量。若要为不同应用设置不同限额，请分别创建规则。"
          }
        }
      }
    },
    "block.sharedUsage.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combined daily usage across devices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス間の1日合算使用量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 합산 하루 사용량"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备合并每日用量"
          }
        }
      }
    },
