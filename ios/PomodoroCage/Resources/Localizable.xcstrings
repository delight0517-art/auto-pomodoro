    "settings.sleepState.healthSyncDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, only a summary of the last 14 days syncs across devices on the same account. It refreshes when the app opens; permission is requested only when you tap this button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、過去14日間の睡眠概要のみ同じアカウントの端末間で同期されます。アプリ起動時に更新し、権限はこのボタンを押したときだけ要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 최근 14일의 수면 구간 요약만 같은 계정의 기기와 동기화해요. 앱을 열 때 갱신하며, 권한은 이 버튼을 누를 때만 요청해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，仅同步最近 14 天的睡眠摘要至同一账户的设备。打开应用时刷新；只有点击此按钮时才会请求权限。"
          }
        }
      }
    },
