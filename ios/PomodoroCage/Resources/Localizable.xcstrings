    "widgetGuide.liveActivityInstructions": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면과 Dynamic Island에는 현재 회차의 남은 시간이 표시돼요. 홈 화면 위젯은 집중·휴식 전환을 이어서 계산합니다. 실시간 표시가 안 보이면 iOS 설정에서 Auto Pomodoro의 Live Activities를 허용하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lock Screen and Dynamic Island show the current phase countdown. The Home Screen widget continues projecting focus/rest transitions. If Live Activities are missing, allow them for Auto Pomodoro in iOS Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面とDynamic Islandには現在の区間の残り時間が表示されます。ホーム画面ウィジェットは集中・休憩の切り替わりも計算します。表示されない場合はiOS設定でAuto Pomodoroのライブアクティビティを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定屏幕和灵动岛会显示当前阶段的倒计时。主屏幕小组件会继续推算专注与休息阶段的切换。如果未显示实时活动，请在 iOS 设置中允许 Auto Pomodoro 使用实时活动。"
          }
        }
      }
    },
