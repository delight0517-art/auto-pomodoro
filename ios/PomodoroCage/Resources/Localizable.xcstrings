    "block.wakeLock.syncDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake time and remaining duration sync. App selections are local to this device and are not replaced by a PC or another iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床時刻と残り時間は同期されます。アプリの選択はこの端末専用で、PCや別のiPhoneの選択には置き換わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 시각과 남은 제한 시간은 동기화됩니다. 차단할 앱은 이 기기에서 따로 선택하며, PC나 다른 iPhone의 선택으로 바뀌지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床时间和剩余时长会同步。应用选择仅保存在此设备，不会被电脑或其他 iPhone 的选择替换。"
          }
        }
      }
    },
