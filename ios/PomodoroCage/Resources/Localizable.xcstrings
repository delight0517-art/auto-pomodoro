    "settings.sleepState.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep is confirmed from intervals saved in Health. Actual sleep or wake times without a recorded interval are shown as estimates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠はヘルスケアに保存された時間帯から確認します。記録がない実際の睡眠・起床時刻は推定として表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 기록은 Health 앱에 저장된 구간으로 확인해요. 기록되지 않은 실제 수면·기상 시각은 추정값으로 분리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠状态根据健康 App 中保存的时间段确认。未记录的实际睡眠或起床时间会标记为估算值。"
          }
        }
      }
    },
