    "appLimit.warning.notification.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 차단이 곧 시작돼요. 저장할 시간을 더 원하면 5분 연장하거나 오늘 차단을 건너뛰세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
