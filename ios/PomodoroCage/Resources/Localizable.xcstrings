    "settings.absence.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running timer resets only when all selected devices have recent activity reports and there has been no input for at least one break. It does not reset if a device is offline or its report is stale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したすべての端末で最近の活動報告があり、休憩時間以上入力がない場合のみタイマーをリセットします。端末がオフライン、または報告が古い場合はリセットしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기기 모두에서 최근 활동 보고가 있고, 휴식 시간 이상 입력이 없을 때만 진행 중인 타이머를 초기화해요. 오프라인이거나 보고가 오래된 기기가 있으면 초기화하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有所有选定设备都有近期活动报告，且无输入时间达到至少一个休息时段时，才会重置正在运行的计时器。设备离线或报告过期时不会重置。"
          }
        }
      }
    },
