    "feedback.form.reviewSla": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 접수 후 3일 안에 피드백을 확인하고 개선 가능 여부와 다음 진행을 안내해요. 실제 수정 완료 시점은 내용에 따라 달라질 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll review feedback within 3 days after the server confirms receipt and share whether we can improve it and what comes next. Fix completion time depends on the issue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー受付の確認後、3日以内に内容を確認し、改善可否と今後の対応をお知らせします。修正完了時期は内容により異なります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器确认收到后，我们会在 3 天内查看反馈，并告知是否改进及后续安排。实际修复时间视问题而定。"
          }
        }
      }
    },
    "feedback.form.savedOffline": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 접수 전이에요. 피드백을 이 기기에 저장했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has not received it yet. Your feedback is saved on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー受付前です。フィードバックをこの端末に保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器尚未收到。反馈已保存在此设备上。"
          }
        }
      }
    },
    "feedback.form.savedOffline.detail": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 닫아도 보관돼요. 앱을 다시 열거나 iOS가 백그라운드 실행을 허용하면 전송을 재개해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays saved if you close the app. Sending resumes when you reopen it or iOS allows a background refresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを閉じても保存されます。再度開くか、iOSがバックグラウンド更新を許可すると送信を再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭应用后仍会保存在此设备。重新打开应用，或 iOS 允许后台刷新时，会继续发送。"
          }
        }
      }
    },
