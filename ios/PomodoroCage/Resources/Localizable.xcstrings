          }
        }
      }
    },
    "feedback.error.http": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 실패 (%d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send feedback (%d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした（%d）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败（%d）"
          }
        }
      }
    },
    "feedback.error.localSave": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 기기에 저장하지 못했거나 전송 대기가 가득 찼어요. 저장 공간과 연결을 확인한 뒤 다시 보내주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback could not be saved or the pending queue is full. Check storage and connection, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを保存できなかったか、送信待ちがいっぱいです。空き容量と接続を確認して再送してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存反馈或待发送队列已满。请检查存储空间和网络后重试。"
          }
        }
      }
    },
    "feedback.error.receiptMissing": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 접수 번호를 돌려주지 않아 저장 여부를 확인하지 못했어. 같은 내용을 다시 보내기 전에 피드백 인박스를 확인해줘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not return a receipt ID, so storage is unconfirmed. Check the feedback inbox before retrying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから受付番号が返らず、保存を確認できません。同じ内容を再送する前に受信箱を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未返回收件编号，无法确认是否已保存。重试前请检查反馈收件箱。"
          }
        }
      }
    },
    "feedback.error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 피드백을 접수하지 못했어요. 작성한 내용은 이 기기에 보관했고 자동 재전송은 멈췄어요. 내용을 확인한 뒤 다시 보내주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not accept your feedback. It is saved on this device, and automatic retries have stopped. Review it and submit again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがフィードバックを受け付けませんでした。内容はこの端末に保存され、自動再送は停止しました。内容を確認して再送してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未能接收反馈。内容已保存在此设备上，自动重试已停止。请检查内容后重新提交。"
          }
        }
      }
    },
