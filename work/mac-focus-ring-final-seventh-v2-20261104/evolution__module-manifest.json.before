{
  "schemaVersion": 1,
  "product": "Auto Pomodoro",
  "runtime": "Electron",
  "authority": "canonical-source-checkout",
  "activation": "inventory-only",
  "modules": [
    "main/store.js",
    "main/sessionStudyStats.js",
    "main/loginItemPolicy.js",
    "main/singleInstanceLock.js",
    "main/preload.js",
    "renderer/shared/widgetSkins.js",
    "main/absencePolicy.js",
    "main/watchdog.js",
    "main/debugLog.js",
    "main/backup.js",
    "main/cloudAccount.js",
    "main/timerCloud.js",
    "main/wakeProtection.js",
    "main/claudeActivityMonitor.js",
    "main/codexTimerActivity.js",
    "main/sharedUsageBudgets.js",
    "main/classSchedule.js",
    "main/noLockSchedule.js",
    "main/scheduledLockWarning.js",
    "main/scheduleSkipDates.js",
    "main/deepMerge.js",
    "main/syncContract.js",
    "main/sharedSettingsContract.js",
    "main/parityFeatures.js",
    "main/i18n.js",
    "main/aiAssistant.js",
    "main/chatgptPlanClient.js",
    "main/aiScreenTimeMonitor.js",
    "main/agentControl.js",
    "main/agentSchedules.js",
    "main/pomodoroScheduleSet.js",
    "main/selahComputerReading.js",
    "main/selahFocusReadingPolicy.js",
    "main/durationOverrides.js",
    "main/adFree.js",
    "main/devHmr.js",
    "main/devProfile.js",
    "package.json"
  ],
  "rendererSurfaces": [
    { "id": "dashboard", "entry": "renderer/dashboard/index.html", "script": "renderer/dashboard/renderer.js", "style": "renderer/dashboard/style.css" },
    { "id": "break", "entry": "renderer/break/index.html", "script": "renderer/break/renderer.js", "style": "renderer/break/style.css" },
    { "id": "widget", "entry": "renderer/widget/index.html", "script": "renderer/widget/renderer.js", "style": "renderer/widget/style.css" },
    { "id": "compact-widget", "entry": "renderer/widget-compact/index.html", "script": "renderer/widget-compact/renderer.js", "style": "renderer/widget-compact/style.css" },
    { "id": "agent-return", "entry": "renderer/agent-return/index.html", "script": "renderer/agent-return/renderer.js", "style": "renderer/agent-return/style.css" }
  ],
  "featureGenres": [
    { "id": "timer-session", "sources": ["main/main.js", "main/store.js", "main/sessionStudyStats.js", "renderer/dashboard/renderer.js", "renderer/widget/renderer.js", "renderer/widget-compact/renderer.js"], "runtimeBoundary": "renderer-reload-or-safe-dev-restart" },
    { "id": "planning-schedules", "sources": ["main/agentSchedules.js", "main/pomodoroScheduleSet.js", "main/durationOverrides.js", "main/scheduleSkipDates.js", "main/classSchedule.js", "main/noLockSchedule.js", "main/scheduledLockWarning.js"], "runtimeBoundary": "safe-dev-restart" },
    { "id": "ai-chat-and-planning", "sources": ["main/aiAssistant.js", "main/chatgptPlanClient.js", "renderer/dashboard/renderer.js"], "runtimeBoundary": "renderer-reload-or-safe-dev-restart" },
    { "id": "focus-and-protection", "sources": ["main/wakeProtection.js", "main/watchdog.js", "main/absencePolicy.js", "main/selahFocusReadingPolicy.js", "main/main.js"], "runtimeBoundary": "safe-dev-restart" },
    { "id": "account-cloud-sync", "sources": ["main/cloudAccount.js", "main/timerCloud.js", "main/syncContract.js", "main/sharedSettingsContract.js", "main/main.js"], "runtimeBoundary": "safe-dev-restart" },
    { "id": "activity-integrations", "sources": ["main/codexTimerActivity.js", "main/claudeActivityMonitor.js", "main/sharedUsageBudgets.js", "main/absencePolicy.js"], "runtimeBoundary": "safe-dev-restart" },
    { "id": "presentation-theme-font", "sources": ["renderer/shared/widgetSkins.js", "renderer/dashboard/style.css", "renderer/widget/style.css", "renderer/widget-compact/style.css"], "runtimeBoundary": "stylesheet-or-renderer-reload" },
    { "id": "settings-preferences", "sources": ["main/store.js", "main/main.js", "renderer/dashboard/renderer.js"], "runtimeBoundary": "renderer-reload-or-safe-dev-restart" },
    { "id": "diagnostics-backup", "sources": ["main/debugLog.js", "main/backup.js", "main/main.js"], "runtimeBoundary": "safe-dev-restart" },
    { "id": "shell-window-platform", "sources": ["main/main.js", "main/preload.js", "main/singleInstanceLock.js", "main/loginItemPolicy.js", "renderer/break/renderer.js", "renderer/agent-return/renderer.js"], "runtimeBoundary": "safe-dev-restart" }
  ],
  "applyBoundary": {
    "rendererCss": "stylesheet-reload",
    "rendererHtmlJs": "guarded-renderer-reload",
    "rendererFontAsset": "guarded-renderer-reload",
    "mainProcessModule": "safe-app-restart",
    "nativeDependencyOrPersistenceSchema": "rebuild-and-safe-restart"
  },
  "safety": {
    "watcherOptIn": "AUTO_POMODORO_HMR=1",
    "launcher": "npm run dev:hmr",
    "dirtyFormsDeferReload": true,
    "activeTimerRestartRequiresExplicitSafeWindow": true,
    "remoteCodeLoading": false,
    "windowsRuntimeParityVerified": false
  }
}
