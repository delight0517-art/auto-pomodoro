/* Auto Pomodoro control center. Shared tokens keep all dashboard panels consistent. */
:root {
  color-scheme: light;
  --page-bg: #f5f7fa;
  --panel-bg: #ffffff;
  --text-color: #17212f;
  --ink-soft: #526174;
  --border-color: #dce3eb;
  --accent: #275dcc;
  --accent-soft: #edf3ff;
  --success: #22683f;
  --error: #b3261e;
  --rail-width: 180px;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--page-bg);
  color: var(--text-color);
  font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
button, input, select, textarea { font: inherit; }
button, select { cursor: pointer; }
button, input, select, textarea { color: inherit; }
button { min-height: 40px; }
a { color: var(--accent); }
:where(button, input, select, textarea, a, summary):focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}
button:disabled { cursor: default; opacity: .55; }
input:not([type=checkbox]):not([type=range]):not([type=color]), select, textarea {
  max-width: 100%;
  min-height: 40px;
  padding: 9px 11px;
  background: var(--panel-bg);
  border: 1px solid #bcc8d6;
  border-radius: 7px;
}
input[readonly] { background: var(--page-bg) !important; }
input[type=checkbox] { width: 18px; height: 18px; margin: 0; flex-shrink: 0; accent-color: var(--accent); }
input[type=range] { accent-color: var(--accent); max-width: 100%; }
textarea { width: 100%; resize: vertical; }
hr { width: 100%; border: 0; border-top: 1px solid var(--border-color); margin: 20px 0; }
h1, h2, h3 { line-height: 1.3; font-weight: 600; }
h2 { font-size: 20px; margin: 28px 0 12px; }
h3 { font-size: 15px; margin: 22px 0 10px; }
p { margin: 0 0 12px; }

/* Application navigation and utility controls. */
.header {
  position: fixed;
  inset: 0 auto 0 0;
  width: var(--rail-width);
  padding: 26px 16px;
  background: var(--panel-bg);
  border-right: 1px solid var(--border-color);
  overflow-y: auto;
  z-index: 10;
}
.product-brand { display: flex; align-items: center; gap: 8px; color: var(--text-color); text-decoration: none; margin-bottom: 8px; }
.product-mark { display: grid; place-items: center; width: 26px; height: 26px; flex-shrink: 0; border-radius: 7px; background: var(--accent); color: #fff; font-weight: 700; }
.header h1 { font-size: 15px; letter-spacing: -.5px; margin: 0; }
.product-purpose { font-size: 12px; line-height: 1.6; color: var(--ink-soft); margin-bottom: 30px; }
.mini-timer-status { display: grid; grid-template-columns: 38px minmax(0, 1fr); align-items: center; gap: 9px; margin-bottom: 20px; }
.mini-timer-ring { --timer-progress: 0deg; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: conic-gradient(var(--accent) var(--timer-progress), #dfe6ef 0); transition: background .35s ease; }
.mini-timer-ring::before { content: ''; width: 28px; height: 28px; border-radius: 50%; background: var(--panel-bg); }
.mini-timer-ring.is-break { background: conic-gradient(#2b8a6e var(--timer-progress), #dfe6ef 0); }
.mini-timer-mode { overflow: hidden; color: var(--ink-soft); font-size: 12px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.timer-progress-native { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.tabs, .nav-primary, .nav-secondary { display: flex; flex-direction: column; gap: 5px; }
.nav-secondary { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-color); }
.tab-btn {
  width: 100%;
  text-align: left;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--ink-soft);
  font-weight: 500;
}
.tab-btn:hover { background: var(--page-bg); color: var(--text-color); }
.tab-btn.active { background: var(--accent-soft); color: #214ea9; font-weight: 600; }
.companion-app-btn { color: var(--accent); }
.companion-app-btn[hidden] { display: none; }
.header-tools {
  position: fixed;
  top: 16px;
  right: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 20;
}
.header-account-badge, .header-feedback-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  height: 40px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background: var(--panel-bg);
  color: var(--ink-soft);
}
.header-account-badge { max-width: 220px; padding: 8px 12px; }
.header-account-badge.logged-in { color: var(--text-color); }
#headerAccountLabel { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.header-feedback-button { width: 40px; padding: 9px; }
.header-account-badge:hover, .header-feedback-button:hover { background: var(--accent-soft); border-color: #a8bce6; }
.header-feedback-button svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
main { margin-left: var(--rail-width); padding: 76px 28px 40px; max-width: 1120px; }
.tab-panel { display: none; min-width: 0; }
.tab-panel.active { display: block; }

/* Timer home: the current session stays visually central and keeps native progress semantics. */
.timer-home { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 420px); align-items: center; gap: 34px 52px; min-height: calc(100vh - 150px); padding: 38px clamp(22px, 5vw, 60px); border: 1px solid var(--border-color); border-radius: 18px; background: var(--panel-bg); box-shadow: 0 18px 50px #17212f0d; }
.timer-home-copy { align-self: center; }
.timer-home .hero-title { margin: 5px 0 8px; font-size: clamp(28px, 4vw, 48px); letter-spacing: -.04em; }
.timer-home .hero-subtitle { max-width: 42ch; font-size: 15px; line-height: 1.7; }
.timer-ring-card { display: flex; flex-direction: column; align-items: center; min-width: 0; }
.timer-ring-visual { --timer-progress: 0deg; display: grid; place-items: center; width: min(42vw, 340px); aspect-ratio: 1; padding: 20px; border-radius: 50%; background: conic-gradient(var(--accent) var(--timer-progress), #e4eaf2 0); box-shadow: 0 18px 45px #275dcc1a; transition: background .35s ease, transform .25s ease; }
.timer-ring-visual::before { content: ''; grid-area: 1 / 1; width: 100%; height: 100%; border-radius: 50%; background: var(--panel-bg); box-shadow: inset 0 0 0 1px #edf0f5; }
.timer-ring-visual.is-break { background: conic-gradient(#2b8a6e var(--timer-progress), #e4eaf2 0); box-shadow: 0 18px 45px #2b8a6e1c; }
.timer-ring-center { position: relative; grid-area: 1 / 1; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.timer-ring-center .status-mode { color: var(--ink-soft); font-size: 15px; }
.timer-ring-center .status-time { margin: 4px 0; color: var(--text-color); font-size: clamp(42px, 6vw, 68px); line-height: 1.05; letter-spacing: -.05em; }
.timer-run-state { color: var(--ink-soft); font-size: 12px; }
.timer-today-card { display: flex; align-items: baseline; justify-content: center; gap: 8px; margin-top: 22px; color: var(--ink-soft); }
.timer-today-card strong { color: var(--text-color); font-size: 24px; font-variant-numeric: tabular-nums; }
.timer-home .status-meta { justify-content: center; margin-top: 14px; }
.timer-home .hero-actions { grid-column: 1 / -1; justify-content: center; }
.hero-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
  padding: 16px 18px;
  border: 1px solid var(--border-color);
  border-left: 3px solid var(--accent);
  border-radius: 10px;
  background: var(--panel-bg);
}
.hero-copy { min-width: 0; }
.hero-kicker { color: var(--ink-soft); font-size: 12px; margin-bottom: 3px; }
.hero-title { font-size: 17px; font-weight: 600; line-height: 1.35; }
.hero-subtitle { margin-top: 4px; max-width: 54ch; font-size: 13px; color: var(--ink-soft); }
.hero-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px; }
.ornate-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 40px;
  padding: 9px 14px;
  background: var(--panel-bg);
  border: 1px solid #bcc8d6;
  border-radius: 7px;
  color: var(--text-color);
  font-weight: 500;
  cursor: pointer;
  align-self: flex-start;
}
.ornate-btn:hover { background: var(--page-bg); border-color: #8c9caf; }
.hero-start, .sync-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.hero-start:hover, .sync-primary:hover { background: #214ea9; border-color: #214ea9; }
.hero-stop-shared { color: var(--error); }
.status-card { padding: 14px 16px; background: var(--page-bg); border: 1px solid var(--border-color); border-radius: 8px; }
.hero-panel .status-card { padding: 0; background: transparent; border: 0; }
.status-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
.status-mode { font-size: 16px; font-weight: 600; }
.status-time { font-size: 24px; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; }
.status-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; color: var(--ink-soft); font-size: 12px; }
.status-pill { padding: 3px 8px; border-radius: 5px; background: var(--page-bg); border: 1px solid var(--border-color); }

/* Settings categories and straightforward label/control rows. */
.settings-intro { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
.settings-intro h2 { margin: 0 0 6px; font-size: 24px; letter-spacing: -.5px; }
.settings-intro p, .settings-group-head p { margin: 0; color: var(--ink-soft); font-size: 13px; }
.settings-intro .save-status { flex-shrink: 0; margin: 4px 0 0; }
.settings-layout { display: flex; flex-direction: column; gap: 18px; }
.settings-nav { display: flex; flex-wrap: wrap; gap: 6px; padding-bottom: 16px; border-bottom: 1px solid var(--border-color); }
.settings-nav a { display: flex; align-items: center; min-height: 40px; padding: 8px 12px; text-decoration: none; color: var(--ink-soft); border: 1px solid transparent; border-radius: 7px; }
.settings-nav a:hover { color: var(--text-color); background: #e9eef5; }
.settings-nav a[aria-current=page] { color: #214ea9; background: var(--accent-soft); border-color: #c4d4f4; font-weight: 600; }
.settings-sections { min-width: 0; }
.settings-group { padding: 22px; background: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 10px; }
.settings-group-head { margin-bottom: 12px; }
.settings-group-head h2 { margin: 0 0 5px; font-size: 18px; }
.settings-form { display: flex; flex-direction: column; gap: 12px; max-width: 620px; }
.settings-form label { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.settings-form input[type=number] { width: 96px; }
#tab-settings .settings-form { max-width: none; gap: 0; }
#tab-settings .settings-form label { min-height: 64px; padding: 12px 0; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; justify-content: flex-start; }
#tab-settings .settings-form label > span { flex: 1; min-width: 140px; }
#tab-settings .settings-form label > input[type=text], #tab-settings .settings-form label > input[type=url] { flex: 1; min-width: 140px; }
#tab-settings .settings-form select { max-width: 58%; }
#tab-settings .settings-form .sync-help { margin: 7px 0 14px; }
.sync-help, .feedback-quota, .feedback-identity { font-size: 13px; line-height: 1.6; color: var(--ink-soft); }
.sync-help { margin: 0; }
.cycle-overview { display: grid; grid-template-columns: minmax(0, 1fr) 16px minmax(0, 1fr) 16px minmax(0, 1fr); gap: 10px; margin: 18px 0; }
.cycle-overview > div { display: flex; flex-direction: column; gap: 5px; padding: 12px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--page-bg); color: var(--ink-soft); font-size: 12px; }
.cycle-arrow { align-self: center; color: #8796a9; text-align: center; }
.cycle-overview input[type=number] {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 6px 10px;
  border: 1px solid #aab9cd;
  border-radius: 6px;
  background: var(--panel-bg);
  color: var(--text-color);
  font-size: 28px;
  line-height: 1.3;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.cycle-overview input[type=number]:hover { border-color: var(--accent); }
.advanced-settings { margin: 18px 0 0; border-top: 1px solid var(--border-color); }
.advanced-settings summary { cursor: pointer; padding: 16px 0; font-weight: 600; }
.advanced-settings[open] summary { margin-bottom: 4px; }
.widget-color-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 4px 16px; margin: 18px 0; padding: 12px 16px; border: 1px solid var(--border-color); border-radius: 8px; }
.widget-color-grid legend { padding: 0 6px; font-weight: 600; }
#tab-settings .settings-form .widget-color-grid label { min-height: 44px; padding: 6px 0; border: 0; flex-wrap: nowrap; }
#tab-settings .settings-form .widget-color-grid label > span { min-width: 0; }
input[type=color] { width: 44px; height: 40px; padding: 3px; border: 1px solid #bcc8d6; border-radius: 7px; background: #fff; cursor: pointer; }
.save-status { color: var(--success); font-size: 12px; margin-left: 8px; }
.save-status.is-error { color: var(--error); }

/* History, statistics and integration panels use the same quiet surfaces. */
.stat-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.stat-card { padding: 16px; background: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 8px; }
.stat-label { font-size: 12px; color: var(--ink-soft); }
.stat-value { font-size: 24px; font-weight: 600; margin-top: 5px; font-variant-numeric: tabular-nums; }
.auto-rhythm-card { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 20px; padding: 18px; background: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 10px; }
.auto-rhythm-copy { min-width: 0; }
.auto-rhythm-kicker { color: var(--ink-soft); font-size: 12px; }
.auto-rhythm-card h2 { margin: 4px 0 6px; font-size: 18px; }
.auto-rhythm-card p { color: var(--ink-soft); font-size: 13px; margin: 0; }
.auto-rhythm-status { margin-top: 8px; font-size: 13px; font-weight: 500; }
.auto-rhythm-card button { flex-shrink: 0; }
canvas { width: 100%; background: var(--panel-bg); border: 1px solid var(--border-color); border-radius: 8px; }
.tag-breakdown { display: flex; flex-direction: column; gap: 8px; }
.tag-row { display: flex; align-items: center; gap: 10px; }
.tag-row .name { width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag-row .bar-track { flex: 1; height: 8px; background: #e5ebf3; border-radius: 4px; overflow: hidden; }
.tag-row .bar-fill { height: 100%; background: var(--accent); }
.tag-row .amount { width: 90px; text-align: right; color: var(--ink-soft); }
.log-filter { margin-bottom: 12px; }
.log-filter input { width: 280px; }
.log-table { width: 100%; border-collapse: collapse; font-size: 13px; background: var(--panel-bg); }
.log-table th, .log-table td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border-color); }
.log-table th { color: var(--ink-soft); font-weight: 600; }
.log-table input { width: 100%; min-height: 34px !important; padding: 5px 7px !important; }
.del-btn, .tor-remove { background: transparent; border: 0; color: var(--error); cursor: pointer; }
.sync-form { max-width: 680px; }
.sync-form input[type=text] { flex: 1; min-width: 0; }
.sync-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.sync-banner { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 14px; background: var(--accent-soft); border: 1px solid #c4d4f4; border-radius: 8px; }
.sync-banner-copy { color: var(--ink-soft); font-size: 13px; }
.lock-status { padding: 14px; background: #fff8eb; border: 1px solid #e4cfa4; border-radius: 8px; color: #71531d; }
.sync-status-line { display: inline-block; }
.sync-status-line.is-success { color: var(--success); font-weight: 600; }
.sync-status-line.is-error { color: var(--error); font-weight: 600; }
.clock-check-table { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
.clock-check-row { display: flex; justify-content: space-between; gap: 12px; padding: 9px 10px; border-radius: 6px; background: #eef2f7; font-size: 12px; }
.clock-check-row.is-success { background: #edf6ef; }
.clock-check-row.is-error { background: #fff0ee; }
.clock-check-name { font-weight: 600; }
.clock-check-value { color: var(--ink-soft); text-align: right; overflow-wrap: anywhere; }
.backup-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.backup-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px; border: 1px solid var(--border-color); border-radius: 7px; background: var(--panel-bg); font-size: 13px; }

/* Dynamic schedule editor: preserve its range and day-selection geometry. */
.time-override-list { display: flex; flex-direction: column; gap: 12px; max-width: 100%; }
.time-override-row { display: flex; flex-direction: column; gap: 10px; padding: 14px; background: var(--page-bg); border: 1px solid var(--border-color); border-radius: 8px; font-size: 13px; }
.time-override-row.disabled { opacity: .6; }
.tor-origin { flex-shrink: 0; padding: 3px 7px; border: 1px solid var(--border-color); border-radius: 5px; background: var(--panel-bg); color: var(--ink-soft); font-size: 11px; white-space: nowrap; }
.tor-top { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.time-override-row input[type=text] { flex: 1 1 100px; min-width: 80px; }
.time-override-row input[type=number] { width: 60px; padding: 8px 6px; }
.tor-group { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; flex-shrink: 0; }
.tor-remove { margin-left: auto; font-size: 15px; }
.tor-timeline { padding: 10px 0 0; }
.tor-track { position: relative; height: 28px; border-radius: 14px; background: #e1e8f3; border: 1px solid #b7c6dc; }
.tor-range { position: absolute; top: 0; bottom: 0; background: #8eace6; }
.tor-range-a { border-radius: 14px 0 0 14px; }
.tor-range-b { border-radius: 0 14px 14px 0; }
.tor-handle { position: absolute; top: 50%; width: 28px; height: 28px; min-height: 28px; border-radius: 50%; background: var(--accent); border: 3px solid #fff; box-shadow: 0 0 0 1px #8b9bb3; transform: translate(-50%, -50%); cursor: ew-resize; padding: 0; }
.tor-handle:hover { background: #214ea9; }
.tor-ticks { display: flex; justify-content: space-between; font-size: 11px; color: var(--ink-soft); margin-top: 8px; padding: 0 2px; }
.tor-bottom { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.tor-time-label { font-weight: 600; font-variant-numeric: tabular-nums; }
.tor-time-label label { display: inline-flex; align-items: center; gap: 5px; }
.tor-time-label input[type=time] { width: 112px; min-height: 34px; padding: 5px 7px; font-variant-numeric: tabular-nums; }
.ls-days { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
#tab-settings .settings-form .ls-day, .ls-day { display: inline-flex; min-height: 36px; align-items: center; gap: 5px; padding: 6px 8px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--panel-bg); font-size: 12px; }
.ls-hint { margin-top: 4px; }

/* Feedback and optional assistant conversations. */
.feedback-dialog { width: min(680px, calc(100vw - 40px)); max-height: 85vh; overflow: auto; padding: 24px; background: var(--panel-bg); color: var(--text-color); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 16px 60px #17212f26; }
.feedback-dialog::backdrop { background: #17212f80; }
.feedback-dialog h2 { margin-top: 0; }
.feedback-event-card { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border: 1px solid color-mix(in srgb, var(--accent-color, #4b9b7b) 32%, var(--border-color)); border-radius: 12px; background: color-mix(in srgb, var(--accent-color, #4b9b7b) 9%, var(--panel-bg)); }
.feedback-event-icon { font-size: 24px; line-height: 1.25; }
.feedback-event-card p, .feedback-review-promise { margin: 5px 0 0; font-size: 13px; line-height: 1.55; color: var(--ink-soft); }
.feedback-review-promise { margin: 0; }
.feedback-dialog form, .feedback-dialog label { display: flex; flex-direction: column; gap: 8px; }
.feedback-dialog form { gap: 16px; }
.feedback-dialog textarea, .feedback-dialog select { width: 100%; }
.feedback-identity { margin: -6px 0 0; }
.feedback-dialog .feedback-consent { flex-direction: row; align-items: flex-start; font-size: 12px; line-height: 1.6; }
.feedback-consent input { margin-top: 2px; }
.feedback-attachment { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
.feedback-attachment img { flex-basis: 100%; width: 100%; max-height: min(60vh, 560px); object-fit: contain; border: 1px solid var(--border-color); border-radius: 8px; background: var(--page-bg); }
#feedbackSubmitStatus { min-height: 1.6em; margin: 0; white-space: pre-line; }
#feedbackSubmit { margin-left: auto; }
.ai-chat-log { display: flex; flex-direction: column; gap: 10px; max-height: 340px; overflow-y: auto; padding: 6px 2px; }
.ai-msg { max-width: 85%; padding: 10px 12px; border-radius: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
.ai-msg-user { align-self: flex-end; background: var(--accent); color: #fff; }
.ai-msg-ai { align-self: flex-start; background: var(--panel-bg); border: 1px solid var(--border-color); }
.sync-primary.is-scanning { position: relative; color: transparent; pointer-events: none; }
.sync-primary.is-scanning::after { content: ''; position: absolute; inset: 50% auto auto 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border: 2px solid #ffffff66; border-top-color: #fff; border-radius: 50%; animation: sync-spin .8s linear infinite; }
@keyframes sync-spin { to { transform: rotate(360deg); } }

@media (max-width: 760px) {
  .header { position: relative; width: 100%; inset: auto; padding: 20px 18px 12px; overflow: visible; border-right: 0; border-bottom: 1px solid var(--border-color); }
  .product-brand { padding-right: 160px; }
  .product-purpose { margin-bottom: 16px; }
  .header-tools { position: absolute; top: 14px; right: 18px; }
  .header-account-badge { max-width: 130px; padding: 8px; font-size: 12px; }
  .tabs { gap: 8px; }
  .nav-primary, .nav-secondary { flex-direction: row; flex-wrap: wrap; gap: 4px; }
  .nav-secondary { margin-top: 4px; padding-top: 8px; }
  .tab-btn { width: auto; padding: 8px 10px; font-size: 13px; }
  main { margin-left: 0; padding: 20px 18px 32px; }
  .timer-home { grid-template-columns: 1fr; min-height: auto; padding: 28px 18px; }
  .timer-home-copy { text-align: center; }
  .timer-home .hero-subtitle { margin-inline: auto; }
  .timer-ring-visual { width: min(78vw, 320px); }
  .hero-panel, .auto-rhythm-card { align-items: stretch; flex-direction: column; }
  .hero-actions { justify-content: flex-start; }
  .hero-panel { margin-bottom: 24px; }
  .settings-intro { gap: 10px; flex-wrap: wrap; }
  .settings-intro h2 { font-size: 22px; }
  .settings-nav { gap: 4px; }
  .settings-nav a { padding: 8px 10px; font-size: 13px; }
  .settings-group { padding: 18px; }
  #tab-settings .settings-form select { max-width: 100%; }
  .stat-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cycle-overview { gap: 6px; }
  .cycle-overview > div { padding: 10px; }
  .sync-banner { align-items: flex-start; flex-direction: column; }
  .feedback-dialog { padding: 20px; }
}
@media (max-width: 460px) {
  .header h1 { font-size: 16px; }
  .header-account-badge { max-width: 110px; }
  #tab-settings .settings-form label > span { min-width: 110px; }
  .cycle-overview { grid-template-columns: 1fr; }
  .cycle-arrow { display: none; }
  .cycle-overview > div { flex-direction: row; align-items: center; justify-content: space-between; }
  .cycle-overview input[type=number] { width: 110px; flex-shrink: 0; }
  .log-table { font-size: 12px; }
  .log-table th, .log-table td { padding: 8px 4px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
